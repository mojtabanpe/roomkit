# Template for /opt/roomkit/.env on the VPS. Copy it there, fill in real
# values, and keep it out of git — placeholders only in this file.
#
#   scp deploy/.env.production.example root@45.159.149.10:/opt/roomkit/.env

# --- Images (the deploy workflow overwrites these two on every run) ---
API_IMAGE=ghcr.io/mojtabanpe/roomkit-api:latest
WEB_IMAGE=ghcr.io/mojtabanpe/roomkit-web:latest

# --- Postgres ---
POSTGRES_USER=roomkit
POSTGRES_PASSWORD=change-me
POSTGRES_DB=roomkit

# --- API ---
CORS_ORIGIN=https://roomkit.ir,https://www.roomkit.ir
# Generate per environment, never reuse the dev value:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Leave this false — and on production, unset. Migrations own the schema and
# run automatically at boot; turning synchronize on instead would let TypeORM
# reshape the database to match the entities with no record of what it did.
DB_SYNCHRONIZE=false

# --- LiveKit (self-hosted on this VPS) ---
# There is no LIVEKIT_API_KEY here on purpose — the key *name* is pinned to
# `roomkit` inside compose.prod.yaml, for both the api and the livekit service,
# so the two can never disagree. Only the secret belongs in this file, and
# LiveKit refuses to start if it is shorter than 32 characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LIVEKIT_API_SECRET=change-me
LIVEKIT_URL=wss://livekit.roomkit.ir

# --- Platform tenants ---
# Guards /api/admin/tenants. Unset means tenant onboarding is closed.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_TOKEN=change-me
USAGE_SWEEP_SECONDS=60
