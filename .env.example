# LiveKit server credentials.
# For LiveKit Cloud: create a project at https://cloud.livekit.io and copy the
# API key/secret and the project's wss:// URL from the project settings.
# For local dev: `brew install livekit` then `livekit-server --dev`
# (listens on ws://localhost:7880 with the devkey/secret below).
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_URL=ws://localhost:7880

# Comma-separated list of origins allowed to call the API. Use "*" for any.
CORS_ORIGIN=http://localhost:4200

# Port the NestJS API listens on.
PORT=3000
