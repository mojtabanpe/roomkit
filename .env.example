# LiveKit server credentials.
# For LiveKit Cloud: create a project at https://cloud.livekit.io and copy the
# API key/secret and the project's wss:// URL from the project settings.
# For local dev: `brew install livekit` then `livekit-server --dev`
# (listens on ws://localhost:7880 with the devkey/secret below).
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_URL=ws://localhost:7880

# Comma-separated list of origins allowed to call the API. Use "*" for any.
# In production: https://roomkit.ir,https://www.roomkit.ir
CORS_ORIGIN=http://localhost:4200

# Port the NestJS API listens on.
PORT=3000

# --- Postgres ---
# `docker compose up -d` starts one with exactly these credentials.
POSTGRES_USER=roomkit
POSTGRES_PASSWORD=roomkit
POSTGRES_DB=roomkit
POSTGRES_PORT=5432
DATABASE_URL=postgres://roomkit:roomkit@localhost:5432/roomkit

# --- Auth ---
# Required. Generate one per environment — never reuse the example value:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-generate-a-random-secret
JWT_EXPIRES_IN=7d
